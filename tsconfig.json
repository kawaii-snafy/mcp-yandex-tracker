{
  "compilerOptions": {
    // Node runs the TypeScript directly (type stripping) and esbuild bundles
    // it, so nothing is ever emitted by tsc — it is here purely as the type
    // checker (`npm run typecheck`). Imports carry their `.ts` extension
    // because that is what Node's type stripping requires.
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // TypeScript 6 no longer picks up @types/* automatically.
    "types": ["node"],

    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "tests", "scripts"]
}
